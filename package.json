{
  "name": "flowboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --configLoader runner",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "mongo:start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force -Path '.\\\\mongo-data','.\\\\mongo-log' | Out-Null; Start-Process -FilePath 'C:\\\\Program Files\\\\MongoDB\\\\Server\\\\8.3\\\\bin\\\\mongod.exe' -ArgumentList @('--dbpath',(Join-Path (Get-Location) 'mongo-data'),'--logpath',(Join-Path (Get-Location) 'mongo-log\\\\mongod.log'),'--bind_ip','127.0.0.1','--port','27017') -WindowStyle Hidden\"",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
